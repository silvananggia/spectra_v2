# Development (default) — proxied via src/setupProxy.js
REACT_APP_API_URL=/api
REACT_APP_STAC_URL=/stac

# Optional proxy targets (used by setupProxy.js)
# API_PROXY_TARGET=http://192.168.101.173:8888
# STAC_PROXY_TARGET=http://192.168.101.173:8082

# Production
# REACT_APP_API_URL=https://spectra.brin.go.id/api
# REACT_APP_STAC_URL=https://spectra.brin.go.id/stac

# Mapbox basemaps: https://account.mapbox.com/access-tokens/
# REACT_APP_MAPBOX_ACCESS_TOKEN=
